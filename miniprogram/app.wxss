page {
  background: #f5f7fb;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2430;
  font-size: 15px;
}

.btn-primary {
  background: #4F8CFF;
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }

.btn-secondary {
  background: #fff;
  color: #4F8CFF;
  border: 2rpx solid #4F8CFF;
  border-radius: 20rpx;
  font-size: 28rpx;
}
.btn-secondary::after { border: none; }

.hint {
  text-align: center;
  color: #8a91a3;
  font-size: 26rpx;
  margin-top: 32rpx;
}

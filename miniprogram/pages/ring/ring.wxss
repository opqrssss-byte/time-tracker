/* 环形模式 · 深色（照桌面组件 DESIGN.md 的血统：表面阶梯 + 发丝描边 + 内高光，不用投影）
   尺寸用 rpx（随屏宽等比）；画布 px 尺寸由 ring.js 按屏宽算好内联注入，两者等价。 */

page {
  background: #0b0c0e;
  height: 100%;
  overflow: hidden;          /* 拖动时页面不能跟着滚 */
}

.ring-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 舞台就是画布的位置盒：画布与它等大，所以环心 = 画布中心，坐标换算只有一处 */
.stage { position: relative; }
.ring-canvas { display: block; }

/* —— 盘下方：候选条 + 引导。都在画布外的正常流里，不压 canvas —— */
.below {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 48rpx;
  min-height: 120rpx;
}
.cand {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #17181c;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  font-weight: 500;
  color: #f4f4f6;
  white-space: nowrap;
  visibility: hidden;        /* 占位不跳版 */
}
.cand.show { visibility: visible; }
.cand-arrow { color: #6a6b6c; font-weight: 400; margin-right: 10rpx; }
.cand .dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  margin-right: 12rpx; flex: none;
}
.cand-name { max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; }
.cand-sep { color: #6a6b6c; font-weight: 400; margin: 0 10rpx; }

.hint {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: #6a6b6c;
  text-align: center;
  opacity: 0;
  transition: opacity 200ms ease;
}
.hint.show { opacity: 1; }

/* 自诊断：只在"触摸坐标算错"这类异常时才会出现 */
.diag {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(255, 90, 90, 0.12);
  border: 2rpx solid rgba(255, 90, 90, 0.35);
  color: #ff9b9b;
  font-size: 22rpx;
  text-align: center;
  max-width: 620rpx;
}

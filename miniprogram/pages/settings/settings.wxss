.page { padding: 24rpx 32rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }
.card-text { color: #8a91a3; font-size: 26rpx; line-height: 1.6; }

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.cat-row:last-of-type { border-bottom: none; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; }
.cat-name { flex: 1; font-size: 29rpx; }
.btn-del { color: #c4c9d6; font-size: 30rpx; padding: 8rpx 12rpx; }
.empty { color: #8a91a3; font-size: 26rpx; }

.add-row { margin-top: 24rpx; }
.add-input {
  background: #f5f7fb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.color-picker { display: flex; gap: 16rpx; margin: 20rpx 0; }
.color-dot {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 4rpx solid transparent;
}
.color-dot.picked { border-color: #1f2430; }
.add-btn { width: 100%; }

.logout-btn {
  margin-top: 24rpx;
  background: #fff;
  color: #FF5A5A;
  border: 2rpx solid #FF5A5A;
  border-radius: 20rpx;
  font-size: 30rpx;
}
.logout-btn::after { border: none; }

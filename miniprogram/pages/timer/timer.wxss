.page { padding: 40rpx 32rpx; }

/* 环形模式入口 */
.ring-cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
  border: 2rpx solid #eef1f6;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}
.ring-cta-hover { background: #f7f9fc; }
.ring-cta-ring {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 8rpx solid #4F8CFF;
  border-right-color: #9B6DFF;
  border-bottom-color: #2FBF71;
  margin-right: 22rpx;
  flex: none;
}
.ring-cta-body { flex: 1; }
.ring-cta-title { font-size: 30rpx; font-weight: 600; }
.ring-cta-sub { font-size: 24rpx; color: #8a91a3; margin-top: 6rpx; }
.ring-cta-go { font-size: 26rpx; color: #4F8CFF; font-weight: 500; flex: none; }

.timer-face { text-align: center; margin: 48rpx 0 36rpx; }
.elapsed {
  font-size: 110rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.running-since { color: #8a91a3; font-size: 26rpx; margin-top: 16rpx; }

.title-input {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  font-size: 34rpx;
  text-align: center;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
  margin: 36rpx 0 48rpx;
}
.cat-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e6e9f0;
  background: #fff;
  font-size: 28rpx;
}
.cat-chip.selected { border-color: #4F8CFF; background: #eef3ff; font-weight: 600; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; }

.btn-big {
  width: 100%;
  padding: 30rpx;
  border-radius: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
.btn-big::after { border: none; }
.btn-start { background: #4F8CFF; }
.btn-stop { background: #FF5A5A; }

/* 快速标签面板 */
.tag-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 24, 35, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 90;
}
.tag-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.tag-panel-title { font-size: 32rpx; font-weight: 700; text-align: center; }
.tag-panel-info { color: #8a91a3; font-size: 26rpx; text-align: center; margin: 10rpx 0 24rpx; }
.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}
.tag-skip {
  text-align: center;
  color: #8a91a3;
  font-size: 26rpx;
  margin-top: 28rpx;
  padding: 12rpx;
}

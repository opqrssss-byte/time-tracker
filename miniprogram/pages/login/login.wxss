.login-wrap {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
}
.logo { font-size: 88rpx; text-align: center; }
.title { text-align: center; font-size: 44rpx; font-weight: 700; margin-top: 16rpx; }
.subtitle { text-align: center; color: #8a91a3; font-size: 28rpx; margin: 12rpx 0 48rpx; }

.tabs {
  display: flex;
  background: #eceff5;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8a91a3;
}
.tab.active { background: #fff; color: #1f2430; font-weight: 600; }

.field {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.code-row { display: flex; gap: 20rpx; align-items: flex-start; }
.code-field { flex: 1; }
.send-btn { margin-top: 8rpx; }

.submit-btn { margin-top: 12rpx; }

.error { color: #FF5A5A; font-size: 26rpx; text-align: center; margin-top: 24rpx; }

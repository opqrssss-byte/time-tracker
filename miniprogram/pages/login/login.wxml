<view class="login-wrap">
  <view class="logo">⏱</view>
  <view class="title">时间追踪</view>
  <view class="subtitle">点一下开始，时间自动记录</view>

  <view class="tabs">
    <view class="tab {{mode === 'otp' ? 'active' : ''}}" bindtap="switchMode" data-mode="otp">验证码登录</view>
    <view class="tab {{mode === 'pwd' ? 'active' : ''}}" bindtap="switchMode" data-mode="pwd">密码登录</view>
  </view>

  <input class="field" type="text" placeholder="邮箱地址" value="{{email}}" bindinput="onEmailInput" />

  <block wx:if="{{mode === 'otp'}}">
    <view class="code-row">
      <input class="field code-field" type="number" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" />
      <button class="btn-secondary send-btn" size="mini" bindtap="sendCode" disabled="{{countdown > 0 || sending}}">
        {{countdown > 0 ? countdown + 's 后重发' : (codeSent ? '重新获取' : '获取验证码')}}
      </button>
    </view>
    <input wx:if="{{needPassword}}" class="field" password placeholder="首次登录请设置密码（至少6位）" value="{{password}}" bindinput="onPasswordInput" />
    <button class="btn-primary submit-btn" bindtap="submitOtp">登录 / 注册</button>
  </block>

  <block wx:else>
    <input class="field" password placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
    <button class="btn-primary submit-btn" bindtap="submitPassword">登录</button>
  </block>

  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>
</view>
